      <Class name="com.divalhr.core.people.internal.JdbcEmployeeImportRepository"/>
      <Class name="com.divalhr.core.people.internal.JdbcEmployeeRepository"/>
      <Class name="com.divalhr.core.people.internal.JdbcEmploymentHistoryRepository"/>
