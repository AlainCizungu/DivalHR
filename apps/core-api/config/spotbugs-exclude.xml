  </Match>
  <!-- MVP-080: operations services, repository and controllers hold injected collaborators; the
       response records hold lists built by the services and never modified. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Class name="~com\.divalhr\.core\.operations\..*"/>
  </Match>
  <!-- MVP-110 value records hold lists that their constructors copy to immutable lists. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Or>
      <Class name="com.divalhr.core.integrations.domain.Webhook"/>
      <Class name="~com\.divalhr\.core\.integrations\.application\.WebhookViews\$.*"/>
      <Class name="~com\.divalhr\.core\.integrations\.messaging\.application\.MessagingViews\$.*"/>
      <Class name="com.divalhr.core.integrations.messaging.domain.Recipient"/>
    </Or>
  </Match>
  <!-- The webhook test transport records what it was asked to send, for assertions. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Class name="~com\.divalhr\.core\.integrations\.WebhookTestConfig\$.*"/>
  </Match>
  <!-- A shared test fixture holds the test's injected MockMvc, JdbcTemplate and clock by design. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Class name="com.divalhr.core.people.schedule.LockedWeeks"/>
  </Match>
  <!-- Test fixtures build JSON with text blocks; platform line separators are irrelevant there. -->
  <Match>
    <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    <Or>
      <Class name="~com\.divalhr\.core\..*Test"/>
      <Class name="com.divalhr.core.support.Organizations"/>
      <Class name="com.divalhr.core.support.Hierarchy"/>
    </Or>
  </Match>
  <!-- The migration test composes its INSERT ... SELECT from its own constant fragments (the line and
       minute expressions of a deliberately wrong export); no external value reaches the statement. -->
  <Match>
    <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
    <Class name="com.divalhr.core.payroll.PayrollLifecycleMigrationIntegrationTest"/>
  </Match>
</FindBugsFilter>
