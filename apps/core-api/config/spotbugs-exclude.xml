<?xml version="1.0" encoding="UTF-8"?>
<!-- Keep exclusions narrow and justified. -->
<FindBugsFilter>
  <!-- Spring beans intentionally hold injected collaborators (constructor injection). -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Source name="~.*Config\.java"/>
  </Match>
  <!--
    Constructor-injected Spring singletons (JsonMapper, MeterRegistry, TransactionTemplate and
    application services) are shared by design; copying them would be wrong. Listed explicitly so
    new classes are still analysed.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
    <Or>
      <Class name="com.divalhr.core.platform.audit.AuditRecorder"/>
      <Class name="com.divalhr.core.platform.error.GlobalExceptionHandler"/>
      <Class name="com.divalhr.core.platform.outbox.OutboxWriter"/>
      <Class name="com.divalhr.core.platform.observability.OperationMetrics"/>
      <Class name="com.divalhr.core.platform.idempotency.IdempotentCreate"/>
      <Class name="com.divalhr.core.platform.idempotency.IdempotentOperation"/>
      <Class name="com.divalhr.core.platform.pagination.CursorCodec"/>
      <Class name="com.divalhr.core.tenant.application.CreateOrganizationService"/>
      <Class name="com.divalhr.core.tenant.application.CreateLegalEntityService"/>
      <Class name="com.divalhr.core.tenant.application.CreateSiteService"/>
      <Class name="com.divalhr.core.tenant.application.HierarchyQueryService"/>
      <Class name="com.divalhr.core.tenant.application.CreateSiteUnitService"/>
      <Class name="com.divalhr.core.tenant.application.SiteUnitQueryService"/>
      <Class name="com.divalhr.core.tenant.application.CreateRegionService"/>
      <Class name="com.divalhr.core.tenant.application.AssignSiteRegionService"/>
      <Class name="com.divalhr.core.tenant.application.CreateTeamService"/>
      <Class name="com.divalhr.core.tenant.application.TeamQueryService"/>
      <Class name="com.divalhr.core.tenant.application.OrganizationDirectoryAdapter"/>
      <Class name="com.divalhr.core.identity.application.CreateInvitationService"/>
      <Class name="com.divalhr.core.identity.application.ResendInvitationService"/>
      <Class name="com.divalhr.core.identity.application.RevokeInvitationService"/>
