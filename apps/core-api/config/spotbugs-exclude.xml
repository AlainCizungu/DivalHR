      <Class name="com.divalhr.core.identity.application.TenantAdminBootstrapService"/>
      <Class name="com.divalhr.core.identity.application.MembershipAuthorityAdapter"/>
      <Class name="com.divalhr.core.identity.application.AccessReviewService"/>
