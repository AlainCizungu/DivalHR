# DivalHR local development environment. DEVELOPMENT ONLY.
# These values are intentionally public placeholders. Never reuse them in any shared, staging or
# production environment, and never put real secrets in this file. Copy to .env to customise.

# PostgreSQL superuser (container bootstrap only)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=dev-only-postgres-admin

# Core API database role (least privilege)
DIVALHR_DB_NAME=divalhr
DIVALHR_DB_USER=divalhr_core
DIVALHR_DB_PASSWORD=dev-only-core-db

# Keycloak bootstrap administrator (development realm only)
KEYCLOAK_ADMIN_USER=dev-kc-admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin

# Core API keyset-cursor HMAC key (>= 32 bytes). The dev-only- prefix is rejected at start-up
# in any environment other than development; staging and production need a real secret.
DIVALHR_CURSOR_SIGNING_KEY=dev-only-cursor-signing-key-not-a-secret-0001

# Invitations (MVP-010). HMAC key for invitee address lookups (>= 32 bytes); the dev-only- prefix
# is rejected outside development.
DIVALHR_EMAIL_LOOKUP_KEY=dev-only-email-lookup-key-not-a-secret-00001
# Secret of the realm's divalhr-core-provisioner client (must match realm-divalhr-dev.json).
DIVALHR_KEYCLOAK_PROVISIONER_SECRET=dev-only-provisioner-secret-2026
DIVALHR_MAIL_FROM=no-reply@divalhr.localhost
# MVP-110: outbound webhooks. AES-256-GCM key material for stored signing secrets (>= 32 bytes);
# the dev-only- prefix is rejected outside development. Never rotate it in place.
DIVALHR_WEBHOOK_ENCRYPTION_KEY=dev-only-webhook-encryption-key-not-a-secret-001
# Host port of the synthetic webhook receiver's control endpoint (127.0.0.1 only).
WEBHOOK_RECEIVER_PORT=8099
# MVP-101: Core -> AI service client credentials (client divalhr-core-ai in realm-divalhr-dev.json).
# The browser never receives it. Unset, the briefing endpoints answer 503 and nothing leaves Core.
DIVALHR_AI_SERVICE_CLIENT_SECRET=dev-only-core-ai-secret-2026

# Host ports (browser-facing)
WEB_PORT=5173
CORE_API_PORT=8080
AI_SERVICE_PORT=8090
# Keycloak is published on 127.0.0.1 only and served over plain HTTP: development-only.
# Staging and production require an https issuer (enforced by the Core API at start-up).
KEYCLOAK_PORT=8180
MAILPIT_UI_PORT=8025
