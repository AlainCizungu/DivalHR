{
  "name": "@divalhr/localization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "French and English product strings. Both locales are required and must stay in parity.",
  "exports": {
    ".": "./src/index.ts",
    "./locales/*": "./locales/*"
  },
  "scripts": {
    "check": "node scripts/check-parity.mjs",
    "lint": "node scripts/check-parity.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@types/node": "24.19.0"
  }
}
